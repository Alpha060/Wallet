# AeroPay Configuration Template
# Copy this file to .env.local and configure your environment variables.

# Server Environment (development / production)
NODE_ENV=development

# Database Connection (MySQL connection string)
# Replace user, password, host, port, and database name with your credentials.
DATABASE_URL=mysql://root:password@127.0.0.1:3306/wallet_db

# Admin Configuration
ADMIN_EMAIL=admin@example.com
