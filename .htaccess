# Root .htaccess - Premium, clean Apache routing for public folder deployment
RewriteEngine On

# Allow Authorization header to pass through to PHP
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# 1. If the requested filename exists under the public/ folder, rewrite and serve it directly
RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
RewriteRule ^(.*)$ public/$1 [L]

# 2. Redirect all other requests to the front controller public/index.php
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/index.php [L]
